# ============================================================
# StormLab — пример конфигурации окружения (.env)
# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env
# Все переменные, кроме BOT_TOKEN, необязательны — без них
# соответствующие функции деградируют gracefully.
# ============================================================

# --- Telegram (ОБЯЗАТЕЛЬНО) -------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenWeatherMap (опционально) -------------------------------------------
# Ключ для фьюжна приземных данных (2+ источника точнее, чем один).
# Бесплатный тариф: https://openweathermap.org/api (активируется ~10 мин)
OPENWEATHERMAP_API_KEY=

# --- Google Gemini (опционально) --------------------------------------------
# AI-анализ грозовой обстановки. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель (по умолчанию gemini-2.0-flash, если не указано)
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (опционально, наивысший приоритет среди AI) ------------------------
# Быстрый бесплатный inference: https://console.groq.com/keys
# Использует модель llama-3.3-70b-versatile
GROQ_API_KEY=

# --- OpenRouter (опционально) ------------------------------------------------
# Агрегатор LLM: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- GitHub Personal Access Token (опционально) ------------------------------
# Доступ к GitHub Models (gpt-4o-mini): https://github.com/settings/tokens
GITHUB_TOKEN=

# --- AiTunnel (опционально, зарезервировано) ---------------------------------
# Совместимый с OpenAI прокси-эндпоинт. В текущей версии config.py эти
# переменные не читаются — оставлены на будущее / для совместимости.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=
AITUNNEL_MODEL=

# --- Администраторы (опционально) --------------------------------------------
# Telegram User ID через запятую — освобождают команды от rate-limit'а.
# Узнать свой ID: @userinfobot
ADMIN_USER_IDS=123456789,987654321
